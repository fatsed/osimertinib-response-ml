# Python and editor environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Downloaded or generated datasets: preserve only the placeholder + documentation
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Temporary experimental outputs; retain small reviewed summary tables separately
/results/tmp/
/experiments/tmp/

# Jupyter checkpoints or temporary files
*.tmp
*.log

# Do not commit large checkpoint files
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.loom
*.rds
*.fastq
*.fastq.gz
*.bam
*.bai
*.sra
*.parquet

# Local GEO audit outputs
/data/metadata/geo_downloads.json
/data/metadata/audit/
/data/metadata/review/